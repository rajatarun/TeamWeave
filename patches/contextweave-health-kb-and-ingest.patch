diff --git a/src/health_api/kb.py b/src/health_api/kb.py
new file mode 100644
index 0000000..185b27a
--- /dev/null
+++ b/src/health_api/kb.py
@@ -0,0 +1,82 @@
+"""Retrieve from the health Bedrock Knowledge Base.
+
+The health bucket is the data source. Bedrock embeds it with
+`twelvelabs.marengo-embed-3-0-v1:0` and stores the vectors in S3 Vectors.
+This module only asks that index a question. It does not embed, and it does
+not read the expertise corpus.
+
+The call stays inside the health API, which is the only authenticated route
+on this service. A caller that invoked Retrieve with its own role would be
+ambient authority over the record.
+"""
+from __future__ import annotations
+
+import logging
+import os
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+EMBEDDING_MODEL_ID = "twelvelabs.marengo-embed-3-0-v1:0"
+
+
+def retrieve_excerpts(question: str, *, knowledge_base_id: str, top_k: int = 6,
+                      client=None) -> list[dict]:
+    """Excerpts in the shape the synthesizer already reads: sourceKey + content."""
+    if client is None:
+        import boto3
+        client = boto3.client("bedrock-agent-runtime")
+
+    response = client.retrieve(
+        knowledgeBaseId=knowledge_base_id,
+        retrievalQuery={"text": question},
+        retrievalConfiguration={
+            "vectorSearchConfiguration": {"numberOfResults": max(1, int(top_k))},
+        },
+    )
+    excerpts = []
+    for item in (response or {}).get("retrievalResults") or []:
+        if not isinstance(item, dict):
+            continue
+        text = ((item.get("content") or {}).get("text") or "").strip()
+        if not text:
+            continue
+        s3_loc = ((item.get("location") or {}).get("s3Location") or {})
+        excerpts.append({"sourceKey": s3_loc.get("uri") or "", "content": text})
+    return excerpts
+
+
+def start_sync(*, client=None) -> dict:
+    """Ask the knowledge base to re-read the health bucket.
+
+    Returns {} when the base is not configured, so a deploy that has not
+    created it yet still ingests into the health database. A job already in
+    progress is not a failure: the next object will be picked up by the run
+    that is underway, and raising here would mark a stored record as uningested.
+    """
+    knowledge_base_id = os.environ.get("HEALTH_KNOWLEDGE_BASE_ID", "").strip()
+    data_source_id = os.environ.get("HEALTH_DATA_SOURCE_ID", "").strip()
+    if not knowledge_base_id or not data_source_id:
+        return {}
+    if client is None:
+        import boto3
+        client = boto3.client("bedrock-agent")
+    try:
+        response = client.start_ingestion_job(
+            knowledgeBaseId=knowledge_base_id,
+            dataSourceId=data_source_id,
+        )
+    except Exception as exc:  # noqa: BLE001 - see below
+        code = ""
+        response = getattr(exc, "response", None)
+        if isinstance(response, dict):
+            code = str((response.get("Error") or {}).get("Code") or "")
+        if code == "ConflictException":
+            logger.info("health knowledge base sync already running")
+            return {"kbSync": "already-running"}
+        # The message is not returned. A service error can echo the object key,
+        # and the key of a health document is itself identifying.
+        logger.exception("health knowledge base sync failed")
+        return {"kbSync": "failed"}
+    job = ((response or {}).get("ingestionJob") or {}).get("ingestionJobId") or ""
+    return {"kbSync": job or "started"}
diff --git a/src/health_api/layout.py b/src/health_api/layout.py
new file mode 100644
index 0000000..edb6efe
--- /dev/null
+++ b/src/health_api/layout.py
@@ -0,0 +1,23 @@
+"""Load `shared` under both package layouts this module is imported in.
+
+Lambda sets `CodeUri` to `src/` and the handler to `health_api.ingest`.
+`health_api` is then the top-level package, and `from ..shared` raises
+`ImportError: attempted relative import beyond top-level package` — the
+function never starts.
+
+Tests import `src.health_api`, where `shared` really is the sibling
+`src.shared` and the relative import is the one that resolves. Both have to
+keep working: a fix that only satisfies the test layout is how this shipped.
+"""
+from __future__ import annotations
+
+import importlib
+from types import ModuleType
+
+
+def shared_module(name: str) -> ModuleType:
+    package = __package__ or ""
+    if "." in package:
+        parent = package.rsplit(".", 1)[0]
+        return importlib.import_module(f"{parent}.shared.{name}")
+    return importlib.import_module(f"shared.{name}")
