@@ -338,3 +338,81 @@ def test_ingest_cannot_write_to_the_health_bucket():
                   (st["Action"] if isinstance(st["Action"], list) else [st["Action"]])
                   if a.startswith("s3:")]
     assert s3_actions == ["s3:GetObject"], s3_actions
+
+
+# ── the health bucket is a Bedrock knowledge base ──────────────────────────
+
+def test_the_health_bucket_is_indexed_with_marengo():
+    """The model id is the one the knowledge base embeds with, and the index
+    is the width that model emits. A 1024-d index would accept the stack and
+    fail the first ingestion."""
+    assert TEMPLATE["Parameters"]["HealthEmbeddingModelId"]["Default"] == (
+        "twelvelabs.marengo-embed-3-0-v1:0"
+    )
+    index = RESOURCES["HealthVectorIndex"]["Properties"]
+    assert index["Dimension"] == 512
+    assert index["DistanceMetric"] == "cosine"
+    kb = RESOURCES["HealthKnowledgeBase"]["Properties"]
+    arn = kb["KnowledgeBaseConfiguration"]["VectorKnowledgeBaseConfiguration"]["EmbeddingModelArn"]
+    assert "${HealthEmbeddingModelId}" in arn["arg"]
+    source = RESOURCES["HealthKnowledgeBaseDataSource"]["Properties"]
+    assert source["DataSourceConfiguration"]["Type"] == "S3"
+    assert source["KnowledgeBaseId"]["arg"] == "HealthKnowledgeBase"
+    api_env = RESOURCES["HealthAPIFunction"]["Properties"]["Environment"]["Variables"]
+    assert api_env["HEALTH_KNOWLEDGE_BASE_ID"]["arg"] == "HealthKnowledgeBase"
+
+
+def test_a_configured_knowledge_base_is_what_gets_read(monkeypatch):
+    monkeypatch.setenv("HEALTH_KNOWLEDGE_BASE_ID", "KBHEALTH")
+    seen = {}
+
+    class Client:
+        def retrieve(self, **kwargs):
+            seen.update(kwargs)
+            return {"retrievalResults": [{
+                "content": {"text": "HbA1c 6.1 in March"},
+                "location": {"s3Location": {"uri": "s3://health/labs.txt"}},
+            }]}
+
+    def boom(*_a, **_k):
+        raise AssertionError("searched the table while a knowledge base is configured")
+
+    monkeypatch.setattr(health_db, "search", boom)
+    monkeypatch.setattr(health_handler, "_synthesize", lambda *a, **k: {"answer": "from the record"})
+    response = health_handler.query({"question": "last lab"}, kb_client=Client())
+    body = json.loads(response["body"])
+    assert seen["knowledgeBaseId"] == "KBHEALTH"
+    assert body["found"] is True
+    assert body["sources"] == ["s3://health/labs.txt"]
+
+
+def test_an_empty_knowledge_base_is_not_filled_in(monkeypatch):
+    monkeypatch.setenv("HEALTH_KNOWLEDGE_BASE_ID", "KBHEALTH")
+
+    class Client:
+        def retrieve(self, **kwargs):
+            return {"retrievalResults": []}
+
+    response = health_handler.query({"question": "q"}, kb_client=Client())
+    body = json.loads(response["body"])
+    assert body["found"] is False
+    assert body["answer"] == ""
+
+
+def test_the_handler_imports_when_health_api_is_top_level():
+    """The Lambda layout: CodeUri is src/, handler is health_api.ingest.
+
+    Importing the package as src.health_api — what the unit tests do — makes
+    `from ..shared` legal. The runtime does not import it that way, and that
+    is the ImportModuleError.
+    """
+    import subprocess
+    import sys
+
+    completed = subprocess.run(
+        [sys.executable, "-c", "import health_api.ingest, health_api.handler"],
+        cwd=REPO / "src",
+        capture_output=True,
+        text=True,
+    )
+    assert completed.returncode == 0, completed.stderr
