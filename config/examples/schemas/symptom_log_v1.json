{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "symptom_log_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reported": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "timeline": {
      "type": "string"
    },
    "seek_care_now": {
      "type": "boolean"
    },
    "seek_care_reason": {
      "type": "string"
    },
    "missing_detail": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "reported",
    "seek_care_now"
  ]
}
