{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api_call_plan_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "requires_human_commit": {
      "type": "boolean"
    },
    "commit_token": {
      "type": "string"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "intent",
    "method",
    "path",
    "requires_human_commit"
  ]
}
