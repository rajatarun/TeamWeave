{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api_call_review_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "safe_to_commit",
        "needs_changes",
        "refuse"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "what_a_person_must_check": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "verdict",
    "reasoning",
    "what_a_person_must_check"
  ]
}
