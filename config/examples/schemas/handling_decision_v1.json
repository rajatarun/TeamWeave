{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handling_decision_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data_element": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "at_rest": {
      "type": "string"
    },
    "in_transit": {
      "type": "string"
    },
    "policy_source": {
      "type": "string",
      "enum": [
        "cipherweave",
        "general_knowledge"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "data_element",
    "at_rest",
    "in_transit",
    "policy_source"
  ]
}
