{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "posting_facts_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string"
    },
    "fetched": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "must_haves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nice_to_haves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_source": {
      "type": "string",
      "enum": [
        "crawl",
        "not_available"
      ]
    }
  },
  "required": [
    "url",
    "fetched",
    "evidence_source"
  ]
}
