{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "day_plan_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "the_one_thing": {
      "type": "string"
    },
    "why_that_one": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "if_the_day_goes_wrong": {
      "type": "string"
    },
    "parked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "string"
    },
    "work": {
      "type": "string",
      "description": "The plan, the exploration, or the decision. Not a restatement of the request."
    }
  },
  "required": [
    "the_one_thing",
    "blocks",
    "work"
  ]
}
