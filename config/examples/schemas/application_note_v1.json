{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "application_note_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opening_line": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "what_it_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_send_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "opening_line",
    "body",
    "what_it_claims"
  ]
}
