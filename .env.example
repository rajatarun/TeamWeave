# Local / script environment — copy to .env (do not commit .env).
# Full CI contract: docs/DEPLOY_CONFIG.md

AWS_REGION=us-east-1
TEAMWEAVE_STACK_NAME=teamweave
TEAMWEAVE_SHARED_STACK_NAME=teamweave-shared
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example-github-actions-sam-deployer
BEDROCK_AGENT_SERVICE_ROLE_ARN=arn:aws:iam::123456789012:role/example-bedrock-agent-service-role
GEMINI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:gemini/api_key-AbCdEf
VPC_ID=vpc-0123456789abcdef0
RDS_SECURITY_GROUP_ID=sg-0123456789abcdef0
VECTOR_DB_HOST=vector-db.cluster-abcdefghijkl.us-east-1.rds.amazonaws.com
VECTOR_DB_TABLE=rag_chunks
CONTEXTWEAVE_URL=https://example.execute-api.us-east-1.amazonaws.com/prod
